{
  "info": {
    "name": "Food API",
    "description": "Collection gerada a partir do contrato OpenAPI em src/main/resources/openapi/swagger.yml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get(\"token\");",
          "const requestUrl = pm.request.url.toString();",
          "const method = pm.request.method;",
          "const isLoginRequest = requestUrl.includes(\"/auth/login\");",
          "const isCreateUserRequest = method === \"POST\" && requestUrl.endsWith(\"/users\");",
          "const shouldSkipAuth = isLoginRequest || isCreateUserRequest;",
          "",
          "if (!token && !shouldSkipAuth) {",
          "  pm.sendRequest({",
          "    url: `${pm.environment.get(\"baseUrl\")}/auth/login`,",
          "    method: \"POST\",",
          "    header: {",
          "      \"Content-Type\": \"application/json\",",
          "      \"Accept\": \"application/json\"",
          "    },",
          "    body: {",
          "      mode: \"raw\",",
          "      raw: JSON.stringify({",
          "        login: pm.environment.get(\"login\"),",
          "        senha: pm.environment.get(\"senha\")",
          "      })",
          "    }",
          "  }, function (err, res) {",
          "    if (err) {",
          "      throw new Error(`Erro ao obter token: ${err}`);",
          "    }",
          "",
          "    if (!res || res.code !== 200) {",
          "      throw new Error(`Erro ao obter token. Status: ${res ? res.code : \"sem resposta\"}`);",
          "    }",
          "",
          "    const response = res.json();",
          "",
          "    if (!response.token) {",
          "      throw new Error(\"Resposta de login nao retornou token.\");",
          "    }",
          "",
          "    pm.environment.set(\"token\", response.token);",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login realizado\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "  pm.environment.set(\"token\", response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
